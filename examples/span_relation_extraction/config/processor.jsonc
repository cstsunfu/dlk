{
    "@processor@default": {
        "data_root": "data",
        "train_data_type": "dataset",
        "valid_data_type": "dataset",
        "feed_order": [
            "fast_tokenizer",
            "token_gather#entity",
            "token_gather#relation",
            "span_cls_relabel",
            "span_relation_relabel"
        ],
        "do_save": true,
        "@subprocessor@fast_tokenizer": {
            "tokenizer_path": "/tmp/bert/tokenizer.json"
        },
        "@subprocessor@token_gather#entity": {
            "token_vocab": "label_vocab#entity.json",
            "gather_columns": [
                {
                    "column": "entities_info",
                    "trace": "labels"
                }
            ],
            "unk": null,
            "pad": null
        },
        "@subprocessor@token_gather#relation": {
            "token_vocab": "label_vocab#relation.json",
            "gather_columns": [
                {
                    "column": "relations_info",
                    "trace": "labels"
                }
            ],
            "unk": null,
            "pad": null
        },
        "@subprocessor@span_cls_relabel": {
            "drop": "none",
            "vocab": "label_vocab#entity.json",
            "output_map": {
                "sparse_label_ids": "sparse_label_ids"
            }
        },
        "@subprocessor@span_relation_relabel": {
            "vocab": "label_vocab#relation.json",
            "sym": false,
            "strict": false,
            "output_map": {
                "sparse_head_label_ids": "sparse_head_label_ids",
                "sparse_tail_label_ids": "sparse_tail_label_ids"
            }
        }
    }
}
