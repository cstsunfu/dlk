{
    "@fit": {
        "specific": {},
        "log_dir": "/workspace/dlk/examples/span_relation_extraction/logs",
        "processed_data_dir": "/workspace/dlk/examples/span_relation_extraction/data/processed_data",
        "@trainer@lightning": {
            "max_epochs": "@lambda @_G.max_epochs",
            "devices": "auto",
            "strategy": "auto",
            "accelerator": "gpu",
            "precision": "bf16-mixed",
            "@callback@lr_monitor": {
                "logging_interval": "step"
            },
            "@callback@checkpoint": {
                "monitor": "val_rel_f1",
                "mode": "max",
                "save_top_k": 0,
                "save_last": false
            },
            "@callback@prograss_bar": {
                "type_bar": "rich"
            }
        },
        "@datamodule@default": {
            "train_batch_size": "@lambda @_G.batch_size",
            "predict_batch_size": 64,
            "num_workers": -1,
            "pin_memory": true,
            "shuffle": true,
            "@dataset@default": {
                "repeat_for_valid": false,
                "key_type_pairs": {
                    "input_ids": "int",
                    "sparse_label_ids": "sparse",
                    "sparse_head_label_ids": "sparse",
                    "sparse_tail_label_ids": "sparse",
                    "gather_index": "long",
                    "type_ids": "long",
                    "special_tokens_mask": "int"
                }
            },
            "@data_collate@span_cls_relation": {
                "gen_mask": {
                    "input_ids": "attention_mask"
                },
                "num_entity_classes": 4,
                "num_relation_classes": 5,
                "key_padding_pairs": {
                    "input_ids": 0,
                    "attention_mask": 0,
                    "special_tokens_mask": 0,
                    "type_ids": 0
                },
                "key_padding_pairs_2d": {}
            }
        },
        "@imodel@default": {
            "gather_metrics": false,
            "@model@basic": {
                "@initmethod@default": {},
                "@embedding@bert_like": {
                    "from_pretrain": true,
                    "pretrained_model_path": "/tmp/bert/",
                    "embedding_dim": 768,
                    "dropout": "@lambda @_G.dropout"
                },
                "@encoder@identity": {},
                "@decoder@multi_decoder": {
                    "@decoder@bilinear#entity": {
                        "input_size": "@lambda @$$$.@embedding.embedding_dim",
                        "output_size": "@lambda @$$$$$.@datamodule.@data_collate.num_entity_classes",
                        "output_map": {
                            "logits": "logits"
                        },
                        "relation_position": "@lambda @_G.relation_position",
                        "efficient": "@lambda @_G.efficient",
                        "apply_tril_mask": true
                    },
                    "@decoder@bilinear#head_relation": {
                        "input_size": "@lambda @$$$.@embedding.embedding_dim",
                        "output_size": "@lambda @$$$$$.@datamodule.@data_collate.num_relation_classes",
                        "output_map": {
                            "logits": "head_logits"
                        },
                        "relation_position": "@lambda @$$.#entity.relation_position",
                        "efficient": "@lambda @$$.#entity.efficient",
                        "apply_tril_mask": "@lambda @$$$$.@postprocessor.sym"
                    },
                    "@decoder@bilinear#tail_relation": {
                        "input_size": "@lambda @$$$.@embedding.embedding_dim",
                        "output_size": "@lambda @$$.#head_relation.output_size",
                        "output_map": {
                            "logits": "tail_logits"
                        },
                        "relation_position": "@lambda @$$.#entity.relation_position",
                        "efficient": "@lambda @$$.#entity.efficient",
                        "apply_tril_mask": "@lambda @$$$$.@postprocessor.sym"
                    }
                }
            },
            "@scheduler@cosine_restart": {
                "num_warmup_steps": 0.01,
                "interval": "epoch",
                "first_restart_step": 2
            },
            "@loss@multi_loss": {
                "loss_collect": "sum",
                "@loss@multilabel_categorical_crossentropy#entity": {
                    "pred_truth_pair": {
                        "logits": "label_ids"
                    },
                    "label_smoothing": "@lambda @_G.label_smoothing"
                },
                "@loss@multilabel_categorical_crossentropy#relation_head": {
                    "pred_truth_pair": {
                        "head_logits": "head_label_ids"
                    },
                    "label_smoothing": "@lambda @_G.label_smoothing"
                },
                "@loss@multilabel_categorical_crossentropy#relation_tail": {
                    "pred_truth_pair": {
                        "tail_logits": "tail_label_ids"
                    },
                    "label_smoothing": "@lambda @_G.label_smoothing"
                }
            },
            "@optimizer@adamw": {
                "lr": "@lambda @_G.lr",
                "eps": 1e-06,
                "optimizer_special_groups": {
                    "order": [
                        "decoder",
                        "bias"
                    ], // the group order, if the para is in decoder & is in bias, set to decoder
                    "bias": {
                        "config": {
                            "weight_decay": 0
                        },
                        "pattern": [
                            "bias",
                            "LayerNorm\\.bias",
                            "LayerNorm\\.weight"
                        ]
                    },
                    "decoder": {
                        "config": {
                            "lr": "@lambda @_G.decoder_lr"
                        },
                        "pattern": [
                            "decoder"
                        ]
                    }
                }
            },
            "@postprocessor@span_relation": {
                "meta_dir": "/workspace/dlk/examples/span_relation_extraction/data/meta_data",
                "entity_label_vocab": "label_vocab#entity.json",
                "relation_label_vocab": "label_vocab#relation.json",
                "start_save_epoch": 1000,
                "sym": false
            }
        }
    },
    "_G": {
        "batch_size": 16
    },
    "@optuna": {
        "study_name": "test_optuna",
        "metric": "val_rel_f1",
        "mode": "max",
        "resources_per_trial": {
            "gpu": 1,
            "cpu": 6
        },
        "num_trials": 100,
        "reduction_factor": 1.5,
        "verbose": 0,
        "resume": false,
        "search_space": {
            "lr": "loguniform(1e-5, 1e-4)",
            "decoder_lr": "loguniform(1e-5, 1e-3)",
            "label_smoothing": "loguniform(1e-10, 1e-1)",
            "relation_position": "choice([True, False])",
            "efficient": "choice([True, False])",
            "dropout": "uniform(0, 0.3)",
            "max_epochs": "choice([10, 15, 20])"
        }
    }
}
