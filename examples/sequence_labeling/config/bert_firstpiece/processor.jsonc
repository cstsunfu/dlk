{
    "@processor@default": {
        "data_root": "data",
        "train_data_type": "dataset",
        "valid_data_type": "dataset",
        "feed_order": [
            "fast_tokenizer",
            "seq_lab_firstpiece_relabel",
            "token_gather",
            "token2id-label"
        ],
        "do_save": true,
        "@subprocessor@fast_tokenizer": {
            "tokenizer_path": "/tmp/bert"
        },
        "@subprocessor@seq_lab_firstpiece_relabel": {},
        "@subprocessor@token_gather": {
            "gather_columns": [
                "labels"
            ],
            "token_vocab": "label_vocab.json",
            "unk": null
        },
        "@subprocessor@token2id-label": {
            "input_map": {
                "tokens": "labels"
            },
            "output_map": {
                "token_ids": "label_ids"
            }
        }
    }
}
