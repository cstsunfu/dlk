{
    "@processor@default": {
        "data_root": "data",
        "feed_order": [
            "hf_tokenizer",
            "seq_lab_firstpiece_relabel",
            "token_gather",
            "token2id-label"
        ],
        "do_save": true,
        "@subprocessor@hf_tokenizer": {
            "tokenizer_path": "./data/bert/tokenizer.json"
        },
        "@subprocessor@seq_lab_firstpiece_relabel": {},
        "@subprocessor@token_gather": {
            "gather_columns": [
                "labels"
            ],
            "token_vocab": "label_vocab.json",
            "unk": null
        },
        "@subprocessor@token2id-label": {
            "input_map": {
                "tokens": "labels"
            },
            "output_map": {
                "token_ids": "label_ids"
            }
        }
    }
}
