{
    "@export": {
        "input_names": [
            "input_ids",
            "attention_mask",
            "_index"
        ],
        "output_names": [
            "logits"
        ],
        "process_config": "./config/processor.jsonc",
        "fit_config": "./config/fit.jsonc",
        "checkpoint": "./logs/0/checkpoint/last.ckpt",
        "output_path": "./data/model.onnx",
        "dynamic_axes": {
            "input_ids": {
                "0": "batch_size",
                "1": "sequence_length"
            },
            "attention_mask": {
                "0": "batch_size",
                "1": "sequence_length"
            },
            "_index": {
                "0": "batch_size"
            },
            "logits": {
                "0": "batch_size"
            }
        },
        "validate": true
    }
}
